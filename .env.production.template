# Historical template. The complete variable list is `.env.example`.
# Set values in the Vercel dashboard. Do not commit them.
# jobbrowser.app Production Environment Variables

# ============================================================================
# Core Node Environment
# ============================================================================
NODE_ENV=production

# ============================================================================
# NextAuth Configuration (OAuth & Sessions)
# ============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars

# Production domain - used for OAuth callbacks
NEXTAUTH_URL=https://jobbrowser.app

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
# Format: postgresql://user:password@host:port/database
# Ensure SSL is enforced for production (add ?sslmode=require)
DATABASE_URL=postgresql://user:password@host:5432/jobbrowser_prod?sslmode=require

# ============================================================================
# Authentication Providers (OAuth)
# ============================================================================
# Google OAuth - https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# Email Service (SendGrid)
# ============================================================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@jobbrowser.app

# ============================================================================
# Error Monitoring & Logging (Sentry)
# ============================================================================
# Create project at: https://sentry.io
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/123456
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/123456
SENTRY_ORG=jobbrowser
SENTRY_PROJECT=jobbrowser-production
SENTRY_AUTH_TOKEN=sntrys_your-auth-token-here

# ============================================================================
# AWS Configuration (Email Queue/S3)
# ============================================================================
# Generate credentials at: https://console.aws.amazon.com
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# ============================================================================
# Supabase Configuration (Storage)
# ============================================================================
# Get from: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Affiliate Networks
# ============================================================================
# Careerjet Affiliate ID - https://www.careerjet.com/affiliates
