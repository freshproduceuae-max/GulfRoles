# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jobbrowser

# External APIs
# Job APIs
INDEED_API_KEY=
LINKEDIN_API_KEY=

# Authentication Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel
VERCEL_URL=

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=JobBrowser
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Email Configuration (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@jobbrowser.app

# Scheduled Jobs
CRON_SECRET=your-cron-secret-here

# Error Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=jobbrowser
SENTRY_PROJECT=jobbrowser
SENTRY_AUTH_TOKEN=

# Affiliate Networks
CAREERJET_AFFILIATE_URL=https://www.careerjet.com/search?a=YOUR_AFFILIATE_ID
JOOBLE_AFFILIATE_URL=https://jooble.org/search
