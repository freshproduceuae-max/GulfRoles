# Copy to .env.local for development. Set the same names in the Vercel project for production.
# Never commit real values. Leave a variable blank to disable that feature.

# --- Required for listings, search, alerts, and employer posts ---
# Pooled Neon URL. Runtime queries use this. Vercel injects it.
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Direct Neon URL for migrations. The build uses this when it is set, then falls back to DATABASE_URL.
# Example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=

# Signs the admin session. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public site URL. Production: https://jobbrowser.app
NEXTAUTH_URL=http://localhost:3000

# Admin sign-in. Use one password form. There is no password in the source code.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional bcrypt hash instead of ADMIN_PASSWORD. Generate with:
# node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "your-password"
ADMIN_PASSWORD_HASH=

# Protects /api/cron/daily and /api/cron/send-alerts. Generate with: openssl rand -base64 32
# Vercel Cron sends this as Authorization: Bearer $CRON_SECRET when the variable is set.
CRON_SECRET=

# Leave unset until the site should appear in search. true opens robots.txt and removes noindex.
SITE_PUBLIC=

# --- Public site ---
NEXT_PUBLIC_APP_NAME=JobBrowser
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_CONTACT_EMAIL=contact@jobbrowser.app

# --- Email (magic links, alert digests, application notices, contact form) ---
# Without these, the site still loads. Employer verify links are returned only in local development.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@jobbrowser.app

# Where CVs are stored. neon keeps them in Postgres and works without extra setup.
# blob uses a private Vercel Blob store. Set the token only when RESUME_STORE=blob.
# Pages always download through JobBrowser, so the store can change later.
RESUME_STORE=neon
BLOB_READ_WRITE_TOKEN=

# Comma list of licensed feeds to ingest on the daily cron.
# Allowed: remoteok, remotive. Set to none to skip them.
# Remotive listings are stored without Google JobPosting markup.
LEGAL_FEEDS=remoteok,remotive

# Careerjet publisher id. CAREERJET_API_KEY is accepted as an alias of the affiliate id.
CAREERJET_AFFILIATE_ID=
CAREERJET_API_KEY=
# IP Careerjet told you to send with server-side queries. Required by their publisher API.
CAREERJET_USER_IP=
# Optional override for the fallback search URL. Ingested jobs redirect to the partner URL instead.
CAREERJET_AFFILIATE_URL=

# Jooble API key from https://jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_AFFILIATE_URL=

# Adzuna covers India, Australia, and the US. It has no UAE or Saudi feed.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_AFFILIATE_URL=

# --- Optional: AdSense, after the site is approved ---
# Leave blank to render no ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=
NEXT_PUBLIC_ADSENSE_SLOT_JOB=

# --- Optional: error monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Optional, unused by the launch build ---
# Present so older notes still match the variable list. The app does not call these providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
INDEED_API_KEY=
LINKEDIN_API_KEY=

# Set only for a private demo database. Never on the public site.
SEED_SAMPLE_JOBS=
SEED_SAMPLE_ADMIN_PASSWORD=
