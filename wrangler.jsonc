{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobbrowser",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jobbrowser"
    }
  ],
  "vars": {
    "CF_WORKER": "1",
    "RESUME_STORE": "neon",
    "EMAIL_FROM": "JobBrowser <noreply@jobbrowser.app>",
    "NEXTAUTH_URL": "https://jobbrowser.jobbrowser.workers.dev",
    "NEXT_PUBLIC_APP_BASE_URL": "https://jobbrowser.jobbrowser.workers.dev"
  },
  "triggers": {
    "crons": ["0 5 * * *", "0 16 * * *"]
  }
}
